"""Network-facing authenticated remote-control API for Jarvis."""

from fastapi import FastAPI

from backend.routes import remote


app = FastAPI(
    title="Jarvis Remote",
    docs_url=None,
    redoc_url=None,
    openapi_url=None,
)

app.include_router(remote.router)


@app.get("/health")
async def remote_health():
    return {
        "status": "ok",
        "service": "jarvis_remote",
    }
