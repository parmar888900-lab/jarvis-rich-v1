# ============================================================
# JARVIS CLOUD RUNTIME
# ============================================================

# FastAPI
JARVIS_ENV=production

# ------------------------------------------------------------
# AI PROVIDERS
# ------------------------------------------------------------

JARVIS_LLM_PROVIDER=cloudflare
JARVIS_IMAGE_PROVIDER=cloudflare

# Required at deployment time.
# Never commit real values.
JARVIS_CLOUDFLARE_ACCOUNT_ID=
JARVIS_CLOUDFLARE_API_TOKEN=

JARVIS_CLOUDFLARE_LLM_MODEL=@cf/meta/llama-3.1-8b-instruct-fast
JARVIS_CLOUDFLARE_FLUX_MODEL=@cf/black-forest-labs/flux-1-schnell

# Local development fallbacks only.
JARVIS_OLLAMA_BASE_URL=http://localhost:11434
JARVIS_OLLAMA_MODEL=qwen2.5:7b

JARVIS_COMFYUI_URL=http://127.0.0.1:8188
JARVIS_COMFYUI_OUTPUT_DIR=/data/comfyui/output
JARVIS_FLUX_WORKFLOW_PATH=/app/configs/workflows/flux_api.json

# ------------------------------------------------------------
# VOICE
# ------------------------------------------------------------

JARVIS_PIPER_EXECUTABLE=piper

JARVIS_PIPER_MODEL_PATH=/data/models/piper/en_GB-northern_english_male-medium.onnx

# ------------------------------------------------------------
# VIDEO
# ------------------------------------------------------------

JARVIS_FFMPEG_EXECUTABLE=ffmpeg

# ------------------------------------------------------------
# GENERATED STORAGE
# ------------------------------------------------------------

JARVIS_GENERATED_DIR=/data/generated

# ------------------------------------------------------------
# DATABASE
# ------------------------------------------------------------

# Application SQLAlchemy engine
DATABASE_URL=sqlite+aiosqlite:////data/database/jarvis.db

# Runtime readiness/capability reporting
JARVIS_DATABASE_URL=sqlite+aiosqlite:////data/database/jarvis.db

# ------------------------------------------------------------
# YOUTUBE
# ------------------------------------------------------------

JARVIS_YOUTUBE_TOKEN_PATH=/data/secrets/youtube_token.json

JARVIS_YOUTUBE_CLIENT_SECRET_PATH=/data/secrets/youtube_client_secret.json
